#################################################################

###  http://rpcw.di.uminho.pt/2026/cinema#título
<http://rpcw.di.uminho.pt/2026/cinema#título> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema/Filme> ;
                                              rdfs:range xsd:string .


###  http://rpcw.di.uminho.pt/2026/cinema/data
<http://rpcw.di.uminho.pt/2026/cinema/data> rdf:type owl:DatatypeProperty ;
                                            rdfs:range xsd:string .


###  http://rpcw.di.uminho.pt/2026/cinema/duração
<http://rpcw.di.uminho.pt/2026/cinema/duração> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema/Filme> ;
                                               rdfs:range xsd:integer .


###  http://rpcw.di.uminho.pt/2026/cinema/temSexo
<http://rpcw.di.uminho.pt/2026/cinema/temSexo> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema/Pessoa> .


#################################################################
#    Classes
#################################################################

###  http://rpcw.di.uminho.pt/2026/cinema#FilmeAventura
<http://rpcw.di.uminho.pt/2026/cinema#FilmeAventura> rdf:type owl:Class ;
                                                     owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Filme>
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/temGénero> ;
                                                                                                  owl:hasValue <http://rpcw.di.uminho.pt/2026/cinema/G_Aventura>
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                     rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Filme> .


###  http://rpcw.di.uminho.pt/2026/cinema#FilmeFicção
<http://rpcw.di.uminho.pt/2026/cinema#FilmeFicção> rdf:type owl:Class ;
                                                   owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Filme>
                                                                                              [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/temGénero> ;
                                                                                                owl:hasValue <http://rpcw.di.uminho.pt/2026/cinema/G_Ficção>
                                                                                              ]
                                                                                            ) ;
                                                                         rdf:type owl:Class
                                                                       ] ;
                                                   rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Filme> .


###  http://rpcw.di.uminho.pt/2026/cinema#FilmeInfantil
<http://rpcw.di.uminho.pt/2026/cinema#FilmeInfantil> rdf:type owl:Class ;
                                                     owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Filme>
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/temGénero> ;
                                                                                                  owl:hasValue <http://rpcw.di.uminho.pt/2026/cinema/G_Infantil>
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                     rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Filme> .


###  http://rpcw.di.uminho.pt/2026/cinema#Personagem
<http://rpcw.di.uminho.pt/2026/cinema#Personagem> rdf:type owl:Class .


###  http://rpcw.di.uminho.pt/2026/cinema/Argumento
<http://rpcw.di.uminho.pt/2026/cinema/Argumento> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Obra> .


###  http://rpcw.di.uminho.pt/2026/cinema/Ator
<http://rpcw.di.uminho.pt/2026/cinema/Ator> rdf:type owl:Class ;
                                            owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Pessoa>
                                                                                       [ rdf:type owl:Restriction ;
                                                                                         owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/atuou> ;
                                                                                         owl:someValuesFrom <http://rpcw.di.uminho.pt/2026/cinema/Filme>
                                                                                       ]
                                                                                     ) ;
                                                                  rdf:type owl:Class
                                                                ] ;
                                            rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Pessoa> ,
                                                            [ rdf:type owl:Class ;
                                                              owl:unionOf ( <http://rpcw.di.uminho.pt/2026/cinema/AtorFeminino>
                                                                            <http://rpcw.di.uminho.pt/2026/cinema/AtorMasculino>
                                                                          )
                                                            ] .


###  http://rpcw.di.uminho.pt/2026/cinema/AtorFeminino
<http://rpcw.di.uminho.pt/2026/cinema/AtorFeminino> rdf:type owl:Class ;
                                                    owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Ator>
                                                                                               [ rdf:type owl:Restriction ;
                                                                                                 owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/temSexo> ;
                                                                                                 owl:hasValue "F"
                                                                                               ]
                                                                                             ) ;
                                                                          rdf:type owl:Class
                                                                        ] ;
                                                    rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Ator> .


###  http://rpcw.di.uminho.pt/2026/cinema/AtorMasculino
<http://rpcw.di.uminho.pt/2026/cinema/AtorMasculino> rdf:type owl:Class ;
                                                     owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Ator>
                                                                                                [ rdf:type owl:Restriction ;
                                                                                                  owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/temSexo> ;
                                                                                                  owl:hasValue "M"
                                                                                                ]
                                                                                              ) ;
                                                                           rdf:type owl:Class
                                                                         ] ;
                                                     rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Ator> .


###  http://rpcw.di.uminho.pt/2026/cinema/Escritor
<http://rpcw.di.uminho.pt/2026/cinema/Escritor> rdf:type owl:Class ;
                                                owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Pessoa>
                                                                                           [ rdf:type owl:Restriction ;
                                                                                             owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/escreveu> ;
                                                                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                  owl:unionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Argumento>
                                                                                                                                <http://rpcw.di.uminho.pt/2026/cinema/Livro>
                                                                                                                              )
                                                                                                                ]
                                                                                           ]
                                                                                         ) ;
                                                                      rdf:type owl:Class
                                                                    ] ;
                                                rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Pessoa> .


###  http://rpcw.di.uminho.pt/2026/cinema/Filme
<http://rpcw.di.uminho.pt/2026/cinema/Filme> rdf:type owl:Class ;
                                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/data> ;
                                                               owl:someValuesFrom xsd:string
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/duração> ;
                                                               owl:someValuesFrom xsd:integer
                                                             ] .


###  http://rpcw.di.uminho.pt/2026/cinema/FilmeDramático
<http://rpcw.di.uminho.pt/2026/cinema/FilmeDramático> rdf:type owl:Class ;
                                                      owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Filme>
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/temGénero> ;
                                                                                                   owl:hasValue <http://rpcw.di.uminho.pt/2026/cinema/G_Drama>
                                                                                                 ]
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                      rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Filme> .


###  http://rpcw.di.uminho.pt/2026/cinema/FilmeRomântico
<http://rpcw.di.uminho.pt/2026/cinema/FilmeRomântico> rdf:type owl:Class ;
                                                      owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Filme>
                                                                                                 [ rdf:type owl:Restriction ;
                                                                                                   owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/temGénero> ;
                                                                                                   owl:hasValue <http://rpcw.di.uminho.pt/2026/cinema/G_Romance>
                                                                                                 ]
                                                                                               ) ;
                                                                            rdf:type owl:Class
                                                                          ] ;
                                                      rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Filme> .


###  http://rpcw.di.uminho.pt/2026/cinema/Género
<http://rpcw.di.uminho.pt/2026/cinema/Género> rdf:type owl:Class ;
                                              owl:equivalentClass [ rdf:type owl:Class ;
                                                                    owl:oneOf ( <http://rpcw.di.uminho.pt/2026/cinema/G_Acção>
                                                                                <http://rpcw.di.uminho.pt/2026/cinema/G_Aventura>
                                                                                <http://rpcw.di.uminho.pt/2026/cinema/G_Comédia>
                                                                                <http://rpcw.di.uminho.pt/2026/cinema/G_Drama>
                                                                                <http://rpcw.di.uminho.pt/2026/cinema/G_Ficção>
                                                                                <http://rpcw.di.uminho.pt/2026/cinema/G_Infantil>
                                                                                <http://rpcw.di.uminho.pt/2026/cinema/G_Romance>
                                                                                <http://rpcw.di.uminho.pt/2026/cinema/G_Terror>
                                                                                <http://rpcw.di.uminho.pt/2026/cinema/G_Thriller>
                                                                              )
                                                                  ] .


###  http://rpcw.di.uminho.pt/2026/cinema/Livro
<http://rpcw.di.uminho.pt/2026/cinema/Livro> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://rpcw.di.uminho.pt/2026/cinema/Obra> .


###  http://rpcw.di.uminho.pt/2026/cinema/Língua
<http://rpcw.di.uminho.pt/2026/cinema/Língua> rdf:type owl:Class .


