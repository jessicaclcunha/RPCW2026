@base <http://rpcw.di.uminho.pt/2026/cinema_inferida> .

<http://rpcw.di.uminho.pt/2026/cinema_inferida> rdf:type owl:Ontology ;
                                                 rdfs:comment [ rdfs:comment "Uma ontologia sobre cinema"@pt
                                                              ] .

#################################################################
#    Object Properties
#################################################################

###  http://rpcw.di.uminho.pt/2026/cinema#representa
<http://rpcw.di.uminho.pt/2026/cinema#representa> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema/Ator> ;
                                                  rdfs:range <http://rpcw.di.uminho.pt/2026/cinema#Personagem> .


###  http://rpcw.di.uminho.pt/2026/cinema#temPersonagem
<http://rpcw.di.uminho.pt/2026/cinema#temPersonagem> rdf:type owl:ObjectProperty ;
                                                     owl:inverseOf <http://rpcw.di.uminho.pt/2026/cinema#éPersonagem> .


###  http://rpcw.di.uminho.pt/2026/cinema#éPersonagem
<http://rpcw.di.uminho.pt/2026/cinema#éPersonagem> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema#Personagem> ;
                                                   rdfs:range <http://rpcw.di.uminho.pt/2026/cinema/Filme> .


###  http://rpcw.di.uminho.pt/2026/cinema/atuou
<http://rpcw.di.uminho.pt/2026/cinema/atuou> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <http://rpcw.di.uminho.pt/2026/cinema/temAtor> .


###  http://rpcw.di.uminho.pt/2026/cinema/compôs
<http://rpcw.di.uminho.pt/2026/cinema/compôs> rdf:type owl:ObjectProperty ;
                                              owl:inverseOf <http://rpcw.di.uminho.pt/2026/cinema/foiComposta> ;
                                              rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema/Pessoa> ;
                                              rdfs:range <http://rpcw.di.uminho.pt/2026/cinema/Obra> .


###  http://rpcw.di.uminho.pt/2026/cinema/escreveu
<http://rpcw.di.uminho.pt/2026/cinema/escreveu> rdf:type owl:ObjectProperty ;
                                                owl:inverseOf <http://rpcw.di.uminho.pt/2026/cinema/foiEscrito> ;
                                                rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema/Pessoa> ;
                                                rdfs:range <http://rpcw.di.uminho.pt/2026/cinema/Obra> .


###  http://rpcw.di.uminho.pt/2026/cinema/foiComposta
<http://rpcw.di.uminho.pt/2026/cinema/foiComposta> rdf:type owl:ObjectProperty .


###  http://rpcw.di.uminho.pt/2026/cinema/foiEscrito
<http://rpcw.di.uminho.pt/2026/cinema/foiEscrito> rdf:type owl:ObjectProperty .


###  http://rpcw.di.uminho.pt/2026/cinema/foiRealizado
<http://rpcw.di.uminho.pt/2026/cinema/foiRealizado> rdf:type owl:ObjectProperty ;
                                                    owl:inverseOf <http://rpcw.di.uminho.pt/2026/cinema/realizou> .


###  http://rpcw.di.uminho.pt/2026/cinema/realizou
<http://rpcw.di.uminho.pt/2026/cinema/realizou> rdf:type owl:ObjectProperty ,
                                                         owl:FunctionalProperty ;
                                                rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema/Pessoa> ;
                                                rdfs:range <http://rpcw.di.uminho.pt/2026/cinema/Filme> .


###  http://rpcw.di.uminho.pt/2026/cinema/temArgumento
<http://rpcw.di.uminho.pt/2026/cinema/temArgumento> rdf:type owl:ObjectProperty .


###  http://rpcw.di.uminho.pt/2026/cinema/temAtor
<http://rpcw.di.uminho.pt/2026/cinema/temAtor> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema/Filme> ;
                                               rdfs:range <http://rpcw.di.uminho.pt/2026/cinema/Pessoa> .


###  http://rpcw.di.uminho.pt/2026/cinema/temGénero
<http://rpcw.di.uminho.pt/2026/cinema/temGénero> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://rpcw.di.uminho.pt/2026/cinema/Filme> ;
                                                 rdfs:range <http://rpcw.di.uminho.pt/2026/cinema/Género> .


###  http://rpcw.di.uminho.pt/2026/cinema/temLíngua
<http://rpcw.di.uminho.pt/2026/cinema/temLíngua> rdf:type owl:ObjectProperty .


###  http://rpcw.di.uminho.pt/2026/cinema/temPaísOrigem
<http://rpcw.di.uminho.pt/2026/cinema/temPaísOrigem> rdf:type owl:ObjectProperty .


###  http://rpcw.di.uminho.pt/2026/cinema/temPeçaMusical
<http://rpcw.di.uminho.pt/2026/cinema/temPeçaMusical> rdf:type owl:ObjectProperty ;
