###  http://rpcw.di.uminho.pt/2026/cinema/Realizador
<http://rpcw.di.uminho.pt/2026/cinema/Realizador> rdf:type owl:Class ;
                                                  owl:equivalentClass [ owl:intersectionOf ( <http://rpcw.di.uminho.pt/2026/cinema/Pessoa>
                                                                                             [ rdf:type owl:Restriction ;
                                                                                               owl:onProperty <http://rpcw.di.uminho.pt/2026/cinema/realizou> ;
