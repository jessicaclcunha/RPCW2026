#################################################################

###  http://rpcw.di.uminho.pt/2026/biblioteca_temporal/Biblioteca_Entre_Ontem_e_Amanha
:Biblioteca_Entre_Ontem_e_Amanha rdf:type owl:NamedIndividual ,
                                          :Biblioteca .


###  http://rpcw.di.uminho.pt/2026/biblioteca_temporal/Cronos
:Cronos rdf:type owl:NamedIndividual ,
                 :Autor ,
                 :Bibliotecário .


###  http://rpcw.di.uminho.pt/2026/biblioteca_temporal/Linha_T0
:Linha_T0 rdf:type owl:NamedIndividual ,
                   :LinhaOriginal .


###  http://rpcw.di.uminho.pt/2026/biblioteca_temporal/Linha_T1
:Linha_T1 rdf:type owl:NamedIndividual ,
                   :LinhaAlternativa .


